{#- Share page template. `standalone` = full HTML document for GitHub Pages. -#}
{%- if standalone %}<!doctype html>
<html lang="en" data-style="{{ cfg.site.theme }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{%- if private %}<meta name="robots" content="noindex, nofollow">{% endif %}
<meta property="og:title" content="{{ cfg.site.title }}">
<meta property="og:description" content="Tournament dates, venues and match times. Tap to add to your calendar.">
{%- endif %}
<title>Revolution Force Schedule</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&family=Figtree:wght@400;500;600;700&family=Saira+Condensed:wght@600;700&family=Saira:wght@400;500;600&display=swap">
<style>
/* Layout: one narrow column, "next up" ticket first, then subscribe/share, then the season list. */
/* STYLE 1 – "Court" (default): gym-floor blue lines, red scoreboard accent, condensed sports type */
:root {
  --bg: #EDF1F6; --surface: #FFFFFF; --ink: #0F1B2D; --muted: #56647A;
  --line: #D5DDE8; --accent: #C8281F; --accent-ink: #FFFFFF; --chip: #E3EAF4; --chip-ink: #1D3A6E;
  --ok: #1B7F4B; --warn-bg: #FFF4D6; --warn-ink: #6B4B00;
  --display: "Barlow Condensed", "Arial Narrow", sans-serif;
  --body: "Barlow", system-ui, sans-serif;
  --radius: 6px; --display-case: uppercase; --display-track: .02em;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #0D1520; --surface: #162131; --ink: #E7EDF5; --muted: #93A1B6;
  --line: #26344A; --accent: #FF5A4E; --accent-ink: #1A0B09; --chip: #1F2E45; --chip-ink: #B9CCEB;
  --ok: #4FD18B; --warn-bg: #3A2F10; --warn-ink: #FFD978; color-scheme: dark; } }
:root[data-theme="dark"] {
  --bg: #0D1520; --surface: #162131; --ink: #E7EDF5; --muted: #93A1B6;
  --line: #26344A; --accent: #FF5A4E; --accent-ink: #1A0B09; --chip: #1F2E45; --chip-ink: #B9CCEB;
  --ok: #4FD18B; --warn-bg: #3A2F10; --warn-ink: #FFD978; color-scheme: dark; }

/* STYLE 2 – "Clean": quiet newsletter look, green accent, rounded friendly sans */
:root[data-style="clean"] {
  --bg: #FFFFFF; --surface: #F5F7F6; --ink: #1A1F1D; --muted: #5E6763;
  --line: #E2E7E4; --accent: #0B6E4F; --accent-ink: #FFFFFF; --chip: #E4F1EC; --chip-ink: #0B5A41;
  --display: "Figtree", system-ui, sans-serif; --body: "Figtree", system-ui, sans-serif;
  --radius: 14px; --display-case: none; --display-track: -.01em;
}
@media (prefers-color-scheme: dark) { :root[data-style="clean"]:not([data-theme="light"]) {
  --bg: #121514; --surface: #1B1F1D; --ink: #E9EEEB; --muted: #9AA59F;
  --line: #2A302D; --accent: #45C495; --accent-ink: #06231A; --chip: #1E3129; --chip-ink: #A7E3CB; } }
:root[data-style="clean"][data-theme="dark"] {
  --bg: #121514; --surface: #1B1F1D; --ink: #E9EEEB; --muted: #9AA59F;
  --line: #2A302D; --accent: #45C495; --accent-ink: #06231A; --chip: #1E3129; --chip-ink: #A7E3CB; }

/* STYLE 3 – "Night game": always dark, arena navy with volleyball-yellow highlights */
:root[data-style="night"] {
  --bg: #0A0F1F; --surface: #131A30; --ink: #EAF0FF; --muted: #95A2C4;
  --line: #242E4D; --accent: #FFC83D; --accent-ink: #1B1400; --chip: #1C2750; --chip-ink: #A9C1FF;
  --ok: #5BE39A; --warn-bg: #3A2F10; --warn-ink: #FFD978;
  --display: "Saira Condensed", "Arial Narrow", sans-serif; --body: "Saira", system-ui, sans-serif;
  --radius: 4px; --display-case: uppercase; --display-track: .04em; color-scheme: dark;
}

*, *::before, *::after { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16px/1.5 var(--body); -webkit-font-smoothing: antialiased; }
a { color: inherit; }
.wrap { max-width: 720px; margin: 0 auto; padding-inline: 16px; padding-block: 20px 48px; display: grid; gap: 28px; }
h1, h2, h3 { font-family: var(--display); text-transform: var(--display-case); letter-spacing: var(--display-track); margin: 0; line-height: 1.05; text-wrap: balance; }
.label { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.num { font-variant-numeric: tabular-nums; }

/* header */
.top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.top h1 { font-size: clamp(30px, 7vw, 44px); font-weight: 800; }
.top h1 span { color: var(--accent); }
.style-pick { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; background: var(--surface); }
.style-pick button { font: 600 13px var(--body); border: 0; background: none; color: var(--muted); padding: 6px 12px; border-radius: 999px; cursor: pointer; }
.style-pick button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }
.style-pick button:focus-visible, .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

.notice { background: var(--warn-bg); color: var(--warn-ink); padding: 10px 14px; border-radius: var(--radius); font-size: 14px; }

/* next-up ticket */
.next { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
.next-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 18px; background: var(--accent); color: var(--accent-ink); }
.next-head .label { color: inherit; opacity: .9; }
.countdown { font-family: var(--display); font-size: 20px; font-weight: 700; text-transform: var(--display-case); }
.next-body { padding: 18px; display: grid; gap: 14px; }
.next-body h2 { font-size: clamp(26px, 6vw, 34px); }
.facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px 20px; }
.facts div { min-width: 0; }
.facts .v { font-weight: 600; }

/* buttons */
.btns { display: flex; flex-wrap: wrap; gap: 8px; }
.btn { display: inline-flex; align-items: center; gap: 6px; font: 600 14px var(--body); text-decoration: none; padding: 9px 14px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.btn:hover { border-color: var(--accent); }
.btn svg { width: 16px; height: 16px; flex: none; }

/* matches */
.matches { width: 100%; border-collapse: collapse; font-size: 15px; }
.matches td { padding: 7px 0; border-top: 1px solid var(--line); vertical-align: top; }
.matches td:first-child { width: 64px; font-weight: 600; }
.matches td.wide { width: 110px; }
.matches .res { text-align: right; white-space: nowrap; font-weight: 600; }
.matches .res.w { color: var(--ok); }
.lede { margin: 0; color: var(--muted); max-width: 60ch; }
.matches td:nth-child(2) { width: 90px; color: var(--muted); }
.matches tr.work td { color: var(--muted); font-style: italic; }
.matches .rnd { color: var(--muted); font-size: 13px; }

/* sections */
section { display: grid; gap: 12px; }
section > h2 { font-size: 24px; }
.panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; display: grid; gap: 12px; }
.panel p { margin: 0; color: var(--muted); font-size: 15px; }
.feed { display: flex; gap: 8px; align-items: center; }
.feed code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; font-size: 13px; padding: 8px 10px; border-radius: var(--radius); background: var(--bg); border: 1px solid var(--line); }

/* season list */
.list { display: grid; gap: 10px; }
.item { display: grid; grid-template-columns: 64px 1fr; gap: 14px; padding: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
.date { text-align: center; border-right: 1px solid var(--line); padding-right: 12px; font-family: var(--display); text-transform: uppercase; }
.date .m { font-size: 13px; color: var(--accent); font-weight: 700; letter-spacing: .06em; }
.date .d { font-size: 30px; font-weight: 700; line-height: 1; }
.item-main { min-width: 0; display: grid; gap: 6px; }
.item h3 { font-size: 20px; }
.meta { display: flex; flex-wrap: wrap; gap: 6px 12px; font-size: 14px; color: var(--muted); align-items: center; }
.chip { display: inline-block; font-size: 12px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: var(--chip); color: var(--chip-ink); }
.chip.live { background: var(--accent); color: var(--accent-ink); }
.place { font-family: var(--display); font-weight: 700; font-size: 20px; color: var(--ok); text-transform: var(--display-case); }
.small-btns { display: flex; flex-wrap: wrap; gap: 6px; }
.small-btns .btn { padding: 5px 10px; font-size: 13px; }
details summary { cursor: pointer; font-size: 14px; font-weight: 600; color: var(--accent); }

.rank-row { display: flex; align-items: center; gap: 16px; }
.rank-big { font-family: var(--display); font-size: 48px; font-weight: 800; line-height: 1; color: var(--accent); min-width: 88px; text-transform: none; }
.rank-meta { min-width: 0; display: grid; gap: 2px; }
.rank-title { font-weight: 600; }
.rank-sub { font-size: 13px; color: var(--muted); }
.live { display: grid; gap: 10px; padding: 14px; border: 1px solid var(--accent); border-radius: var(--radius); }
.live-head { display: flex; align-items: center; gap: 8px; }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
@media (prefers-reduced-motion: no-preference) { .dot { animation: pulse 1.6s ease-in-out infinite; } @keyframes pulse { 50% { opacity: .3; } } }
.live-big { font-family: var(--display); font-size: 26px; font-weight: 700; text-transform: var(--display-case); line-height: 1.1; }
.scroll-x { overflow-x: auto; }
.live .res { font-weight: 600; }
.live .res.w { color: var(--ok); }
.standings { width: 100%; border-collapse: collapse; font-size: 14px; }
.standings caption { text-align: left; padding-bottom: 4px; }
.standings th { text-align: left; font-size: 12px; color: var(--muted); font-weight: 600; padding: 4px 6px 4px 0; }
.standings td { padding: 6px 6px 6px 0; border-top: 1px solid var(--line); white-space: nowrap; }
.standings tr.me td { font-weight: 700; color: var(--accent); }
footer { font-size: 13px; color: var(--muted); display: grid; gap: 4px; border-top: 1px solid var(--line); padding-top: 16px; }
.toast { position: fixed; left: 50%; bottom: calc(20px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); background: var(--ink); color: var(--bg); padding: 8px 16px; border-radius: 999px; font-size: 14px; }
@media (max-width: 440px) { .item { grid-template-columns: 52px 1fr; gap: 10px; } .date .d { font-size: 24px; } }
@media (prefers-reduced-motion: no-preference) { .btn { transition: border-color .15s; } }
</style>
{%- if standalone %}
</head>
<body>
{%- endif %}
<script>
  (function () {
    var s = null; try { s = localStorage.getItem("rf-style"); } catch (e) {}
    document.documentElement.dataset.style = s || "{{ cfg.site.theme }}";
  })();
</script>
{%- set ico_cal %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>{% endset %}
{%- set ico_pin %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-7.2 7-12a7 7 0 1 0-14 0c0 4.8 7 12 7 12Z"/><circle cx="12" cy="10" r="2.5"/></svg>{% endset %}
{%- set ico_link %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>{% endset %}
{%- macro matches_table(t) %}
  {%- if t.matches %}
  <table class="matches num">
    {%- for m in t.matches %}
    <tr class="{{ 'work' if m.role == 'work' }}"><td>{{ m.time or ('—' if m.round == 'Pool play' else '') }}</td><td>{{ m.court }}</td><td>{% if m.round and m.round != 'Pool play' and m.opponent %}<span class="rnd">{{ m.round }}</span> {% endif %}{{ ('vs ' ~ m.opponent) if m.opponent else m.round }}</td>{% if m.result %}<td class="res {{ 'w' if m.result.startswith('W') }}">{{ m.result }}</td>{% endif %}</tr>
    {%- endfor %}
  </table>
  {%- endif %}
{%- endmacro %}

<main class="wrap">
  <header class="top">
    <div>
      <div class="label">OVA 15U &amp; TLS Girls tournaments</div>
      <h1>{{ cfg.team.name | replace('Revolution Force', '<span>Revolution Force</span>') | safe }}</h1>
    </div>
    <div class="style-pick" role="group" aria-label="Page style">
      <button type="button" data-set="sport">Court</button>
      <button type="button" data-set="clean">Clean</button>
      <button type="button" data-set="night">Night</button>
    </div>
  </header>

  {%- if has_sample %}
  <div class="notice">Sample data shown. Edit <code>data/tournaments.yaml</code>.</div>
  {%- endif %}
  {%- for w in warnings %}<div class="notice">{{ w }}</div>{% endfor %}

  {%- set n = upcoming[0] if upcoming else None %}
  {%- if n %}
  <article class="next" data-start="{{ n.start }}" data-end="{{ n.end or n.start }}">
    <div class="next-head">
      <span class="label">Next tournament</span>
      <span class="countdown num" id="countdown">{% if n._status == 'live' %}Today{% else %}In {{ n._days_until }} days{% endif %}</span>
    </div>
    <div class="next-body">
      <h2>{{ n.name }}</h2>
      <div class="facts">
        <div><div class="label">Date</div><div class="v">{{ n._date_label }}</div></div>
        <div><div class="label">First match</div><div class="v num">{{ n.first_match or 'Posted ~1 week before' }}</div></div>
        <div><div class="label">Venue</div><div class="v">{{ n.venue or 'TBA' }}</div></div>
        <div><div class="label">Tier</div><div class="v">{{ n.division or 'Posted ~1 month before' }}</div></div>
      </div>
      {%- if n.live %}
      <div class="live">
        <div class="live-head"><span class="dot" aria-hidden="true"></span><span class="label">Game day · updated {{ n.live_checked }}</span></div>
        {%- if n.live.next %}
        <div class="live-next">
          <div class="label">Next match</div>
          <div class="live-big">vs {{ n.live.next.opponent }}</div>
          <div class="meta">{% if n.live.next.time %}<span class="num">{{ n.live.next.time }}</span>{% endif %}{% if n.live.next.court and n.live.next.court not in (n.live.next.time or '') %}<span>{{ n.live.next.court }}</span>{% endif %}<span>{{ n.live.next.round }}</span></div>
        </div>
        {%- endif %}
        {%- if n.live.last %}
        <div class="meta"><span class="label">Last</span><span class="res {{ 'w' if n.live.last.won }}">{{ n.live.last.label }} {{ n.live.last.score }}</span><span>vs {{ n.live.last.opponent }}</span><span class="num">({{ n.live.last.sets }})</span></div>
        {%- endif %}
        {%- if n.live.standings %}
        <div class="scroll-x">
        <table class="standings num">
          <caption class="label">{{ n.live.pool }} · unofficial</caption>
          <tr><th>Team</th><th>W</th><th>L</th><th>Sets</th><th>Pts</th></tr>
          {%- for r in n.live.standings %}
          <tr class="{{ 'me' if r.team == n.live.team }}"><td>{{ r.team }}</td><td>{{ r.w }}</td><td>{{ r.l }}</td><td>{{ r.sw }}-{{ r.sl }}</td><td>{{ r.pf }}-{{ r.pa }}</td></tr>
          {%- endfor %}
        </table>
        </div>
        {%- endif %}
        <p class="lede">This page refreshes about every 10 minutes on tournament days. For up-to-the-second scores, use the timu buttons.</p>
      </div>
      {%- endif %}
      {{ matches_table(n) }}
      {%- if n.notes %}<div class="meta">{{ n.notes }}</div>{% endif %}
      <div class="btns">
        <a class="btn primary" href="{{ n._gcal }}" target="_blank" rel="noopener">{{ ico_cal }}Add to Google Calendar</a>
        <a class="btn" href="{{ n._ics }}">{{ ico_cal }}Apple / Outlook</a>
        {%- if n._map %}<a class="btn" href="{{ n._map }}" target="_blank" rel="noopener">{{ ico_pin }}Directions</a>{% endif %}
        {%- if n.links.schedule and n.links.playoffs %}
        <a class="btn" href="{{ n.links.schedule }}" target="_blank" rel="noopener">{{ ico_link }}Schedule</a>
        <a class="btn" href="{{ n.links.results }}" target="_blank" rel="noopener">{{ ico_link }}Results</a>
        <a class="btn" href="{{ n.links.playoffs }}" target="_blank" rel="noopener">{{ ico_link }}Playoffs</a>
        <a class="btn" href="{{ n.links.pools }}" target="_blank" rel="noopener">{{ ico_link }}Pools</a>
        {%- endif %}
        {%- if n.links.ova %}<a class="btn" href="{{ n.links.ova }}" target="_blank" rel="noopener">{{ ico_link }}OVA event page</a>{% endif %}
        {%- if n.links.aes %}<a class="btn" href="{{ n.links.aes }}" target="_blank" rel="noopener">{{ ico_link }}Live scores (AES)</a>{% endif %}
      </div>
    </div>
  </article>
  {%- else %}
  <article class="next">
    <div class="next-head">
      <span class="label">Next tournament</span>
      <span class="countdown">Not posted yet</span>
    </div>
    <div class="next-body">
      <h2>Waiting for OVA seeding</h2>
      <p class="lede">Divisions are usually posted about a week before each event. This page checks timu.ca every few hours and adds the tournament as soon as {{ cfg.team.short_name }} appears.</p>
      {%- if division_events %}
      <div class="label">Coming up in 15U &amp; TLS Girls</div>
      <table class="matches num">
        {%- for e in division_events %}<tr><td class="wide">{{ e.label }}</td><td colspan="2">{{ e.name }}</td></tr>{% endfor %}
      </table>
      {%- endif %}
      <div class="btns"><a class="btn" href="https://timu.ca/ova/index.php" target="_blank" rel="noopener">{{ ico_link }}Open OVA Tourney (timu.ca)</a></div>
    </div>
  </article>
  {%- endif %}

  {%- if ranking and (ranking.entries or ranking.splits) %}
  <section id="ranking">
    <h2>OVA ranking</h2>
    <div class="panel rank-panel">
      {%- for e in ranking.entries[:2] %}
      <div class="rank-row">
        <div class="rank-big num">{{ ordinal(e.rank) if e.rank else 'NR' }}</div>
        <div class="rank-meta">
          <div class="rank-title">{% if e.rank %}of {{ e.of }} teams · {% endif %}{{ e.age_group }}</div>
          <div class="rank-sub">{{ e.title }}{% for k, v in e.detail.items() if k in ['Pre OC Rank', 'Top 2 Average', 'Overall Points', 'Overall Points Average', 'Division Finish'] %} · {{ k }} {{ v }}{% endfor %}</div>
        </div>
      </div>
      {%- endfor %}
      {%- if not ranking.has_current %}
      <p>{{ ranking.season }} rankings are posted after each OVA event, starting with the Provincial Cup. This updates automatically.</p>
      {%- endif %}
      <div class="small-btns">
        <a class="btn" href="https://www.ontariovolleyball.org/girls-team-rankings" target="_blank" rel="noopener">{{ ico_link }}All girls rankings</a>
        {%- for sp in ranking.splits %}<a class="btn" href="{{ sp.url }}" target="_blank" rel="noopener">{{ ico_link }}{{ sp.label }}</a>{% endfor %}
      </div>
      {%- if ranking.fetched %}<div class="rank-sub">Checked {{ ranking.fetched }}</div>{% endif %}
    </div>
  </section>
  {%- endif %}

  <section>
    <h2>Get every tournament in your calendar</h2>
    <div class="panel">
      <p>Subscribe once. New tournaments and time changes appear automatically, with a reminder the night before.</p>
      <div class="btns">
        <a class="btn primary" href="{{ gcal_subscribe }}" target="_blank" rel="noopener">{{ ico_cal }}Google Calendar</a>
        <a class="btn" href="{{ feed_webcal }}">{{ ico_cal }}iPhone / Mac / Outlook</a>
      </div>
      <div class="feed"><code id="feed">{{ feed_https }}</code><button class="btn" type="button" data-copy="feed">Copy</button></div>
    </div>
  </section>

  <section>
    <h2>Share with the team</h2>
    <div class="panel">
      <p>Sends the next three tournaments and a link to this page.</p>
      <div class="btns">
        <a class="btn primary" href="{{ whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>
        <a class="btn" href="{{ mailto }}">Email</a>
        <button class="btn" type="button" data-copy="share-text">Copy message</button>
      </div>
      <pre id="share-text" hidden>{{ share_text }}</pre>
    </div>
  </section>

  <section>
    <h2>Season schedule</h2>
    <div class="list">
      {%- for t in upcoming %}
      <article class="item">
        <div class="date num"><div class="m">{{ t._start.strftime('%b') }}</div><div class="d">{{ t._start.day }}</div></div>
        <div class="item-main">
          <h3>{{ t.name }}</h3>
          <div class="meta">
            <span class="chip {{ 'live' if t._status == 'live' }}">{{ 'Today' if t._status == 'live' else t.age_group }}</span>
            {%- if t.division %}<span class="chip">{{ t.division }}</span>{% endif %}
            <span>{{ t._date_label }}</span>
            <span>{{ t.venue or 'Venue TBA' }}</span>
            {%- if t.first_match %}<span class="num">First match {{ t.first_match }}</span>{% endif %}
          </div>
          {%- if t.matches %}<details><summary>Match schedule</summary>{{ matches_table(t) }}</details>{% endif %}
          <div class="small-btns">
            <a class="btn" href="{{ t._gcal }}" target="_blank" rel="noopener">{{ ico_cal }}Google</a>
            <a class="btn" href="{{ t._ics }}">{{ ico_cal }}.ics</a>
            {%- if t._map %}<a class="btn" href="{{ t._map }}" target="_blank" rel="noopener">{{ ico_pin }}Map</a>{% endif %}
            {%- for label, url in t.links.items() if url %}<a class="btn" href="{{ url }}" target="_blank" rel="noopener">{{ ico_link }}{{ label | upper }}</a>{% endfor %}
          </div>
        </div>
      </article>
      {%- endfor %}
    </div>
  </section>

  {%- if past %}
  <section>
    <h2>Results</h2>
    <div class="list">
      {%- for t in past %}
      <article class="item">
        <div class="date num"><div class="m">{{ t._start.strftime('%b') }}</div><div class="d">{{ t._start.day }}</div></div>
        <div class="item-main">
          <h3>{{ t.name }}</h3>
          <div class="meta"><span class="chip">{{ t.age_group }}</span>{% if t.division %}<span class="chip">{{ t.division }}</span>{% endif %}<span>{{ t.venue }}</span></div>
          {%- if t.placement %}<div class="place">{{ t.placement }}</div>{% endif %}
          {%- if t.matches %}<details><summary>Matches</summary>{{ matches_table(t) }}</details>{% endif %}
          {%- if t.links.results %}<div class="small-btns"><a class="btn" href="{{ t.links.results }}" target="_blank" rel="noopener">{{ ico_link }}Full results</a></div>{% endif %}
        </div>
      </article>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  <footer>
    <div>Updated {{ updated }}. Checks the OVA Tourney app (timu.ca) every few hours, and hourly on tournament weekends.</div>
    <div>Unofficial parent-run page. Official schedules: <a href="https://timu.ca/ova/index.php" target="_blank" rel="noopener">timu.ca/ova</a> · <a href="https://www.ontariovolleyball.org/" target="_blank" rel="noopener">ontariovolleyball.org</a></div>
  </footer>
</main>
<div class="toast" id="toast" hidden></div>

<script>
(function () {
  var root = document.documentElement;
  var btns = document.querySelectorAll(".style-pick button");
  function mark() { btns.forEach(function (b) { b.setAttribute("aria-pressed", String(b.dataset.set === root.dataset.style)); }); }
  btns.forEach(function (b) {
    b.addEventListener("click", function () {
      root.dataset.style = b.dataset.set; mark();
      try { localStorage.setItem("rf-style", b.dataset.set); } catch (e) {}
    });
  });
  mark();

  var toast = document.getElementById("toast"), tId;
  function say(msg) { toast.textContent = msg; toast.hidden = false; clearTimeout(tId); tId = setTimeout(function () { toast.hidden = true; }, 1800); }
  document.querySelectorAll("[data-copy]").forEach(function (b) {
    b.addEventListener("click", function () {
      var el = document.getElementById(b.dataset.copy), text = el.textContent;
      function fallback() {
        el.hidden = false; var r = document.createRange(); r.selectNodeContents(el);
        var s = getSelection(); s.removeAllRanges(); s.addRange(r); say("Selected. Press Copy on your device.");
      }
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(function () { say("Copied"); }, fallback); else fallback();
    });
  });

  // Keep the countdown accurate between rebuilds
  var next = document.querySelector(".next"), cd = document.getElementById("countdown");
  if (next && cd) {
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var s = new Date(next.dataset.start + "T00:00"), e = new Date(next.dataset.end + "T00:00");
    var days = Math.round((s - today) / 864e5);
    cd.textContent = (today >= s && today <= e) ? "Today" : days === 1 ? "Tomorrow" : days > 1 ? "In " + days + " days" : "Done";
  }
})();
</script>
{%- if standalone %}
</body>
</html>
{%- endif %}
